<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.AiHelper</id>
  <version>3.800.0</version>
  <version-tag></version-tag>

  <platformVersion>3.906.0</platformVersion>
  <dependencies>
    <!--<dependency id="VirtoCommerce.Core" version="3.800.0" />-->
  </dependencies>

  <title>AiHelper</title>
  <description>Provides core AI functionality</description>

  <authors>
    <author>Vladimir Buravlev</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-ai-helper</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.AiHelper)/Content/logo.png</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.AiHelper.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.AiHelper.Web.Module, VirtoCommerce.AiHelper.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2025 VirtoCommerce. All rights reserved</copyright>
  <tags>VirtoCommerce AI Helper module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
  <apps>
    <app id="ai-helper-app">
      <title>AI Helper</title>
      <iconUrl>/apps/ai-helper-app/img/icons/aihelper32.png</iconUrl>
      <supportEmbeddedMode>true</supportEmbeddedMode>
      <permission>ai-helper:access</permission>
    </app>
  </apps>
</module>
